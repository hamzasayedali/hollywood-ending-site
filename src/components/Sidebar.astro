<script>
	// Mobile only: the toggle is hidden on desktop, where the links are always shown.
	for (const toggle of document.querySelectorAll<HTMLButtonElement>(".sidebar__toggle")) {
		toggle.addEventListener("click", () => {
			const open = toggle.getAttribute("aria-expanded") !== "true";
			toggle.setAttribute("aria-expanded", String(open));
			toggle.closest(".sidebar")?.classList.toggle("sidebar--open", open);
		});
	}
</script>
