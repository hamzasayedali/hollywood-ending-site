---
// Text beside an image (image on the right by default); stacks vertically on mobile.
// `src` is a path inside public/, e.g. "/images/he-book-cover.jpeg".
interface Props {
	src: string;
	alt: string;
	imageSide?: "left" | "right";
}

const { src, alt, imageSide = "right" } = Astro.props;
const imgSrc = `${import.meta.env.BASE_URL}/${src}`.replace(/\/{2,}/g, "/");
---

<div class:list={["ltri", { "ltri--image-left": imageSide === "left" }]}>
	<div class="ltri__text">
		<slot />
	</div>
	<figure class="ltri__img">
		<img src={imgSrc} alt={alt} />
		{Astro.slots.has("caption") && (
			<figcaption class="img-caption"><slot name="caption" /></figcaption>
		)}
	</figure>
</div>

<style>
	.ltri {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 24px;
		margin: 16px 0;
	}

	.ltri--image-left {
		flex-direction: row-reverse;
	}

	.ltri__text {
		flex: 1 1 0;
		min-width: 0;
	}

	.ltri__img {
		flex: 0 1 50%;
		max-width: 500px;
		/* Push the image down so the text's heading sits above it in row view. */
		margin: 3.5em 0 0;
	}

	.ltri__img img {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (max-width: 700px) {
		.ltri,
		.ltri--image-left {
			flex-direction: column;
		}

		.ltri__img {
			flex-basis: auto;
			width: 70%;
			margin-top: 0;
			align-self: center;
		}
	}
</style>
